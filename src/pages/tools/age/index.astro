---
import ToolPage from '../../../components/ToolPage.astro';
---
<ToolPage eyebrow="날짜 · Age" title="나이 계산기" description="생년월일과 기준일을 바탕으로 정확한 만 나이를 계산합니다.">
  <section class="tool-card tool-card-single"><h2>만 나이 계산</h2><form data-age-form><label>생년월일<input name="birth" type="date" required /></label><label>기준일<input name="reference" type="date" required /></label><button type="submit">계산하기</button></form><output class="result" data-age-result aria-live="polite">생년월일과 기준일을 입력해 보세요.</output></section>
  <section class="tool-info"><h2>사용 방법</h2><ol><li>생년월일을 입력합니다.</li><li>기준일을 선택하고 계산합니다.</li></ol><h2>계산 기준</h2><p>기준일까지 생일이 지났는지 비교해 만 나이를 계산합니다. 기준일은 오늘이 아니어도 직접 바꿀 수 있습니다.</p><h2>예시</h2><p>2000-01-10을 2026-09-14 기준으로 계산하면 만 26세입니다.</p><h2>자주 묻는 질문</h2><p><strong>기준일을 변경할 수 있나요?</strong><br />네. 원하는 날짜를 직접 입력할 수 있습니다.</p><p><strong>미래 생년월일을 입력하면?</strong><br />올바르지 않은 날짜라는 안내를 표시합니다.</p></section>
  <nav class="related-tools" aria-label="관련 도구"><h2>관련 도구</h2><a href="/tools/date-difference/">날짜 차이 계산기</a><a href="/tools/time-calculator/">시간 계산기</a></nav>
</ToolPage>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-age-form]'); const result = document.querySelector<HTMLOutputElement>('[data-age-result]');
  if (!form || !result) throw new Error('나이 계산기 요소를 찾을 수 없습니다.');
  const validDate = (v: string) => { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v); if (!m) return null; const d = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]))); return d.getUTCFullYear() === Number(m[1]) && d.getUTCMonth() === Number(m[2]) - 1 && d.getUTCDate() === Number(m[3]) ? d.getTime() : null; };
  form.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); const birth = String(data.get('birth')); const reference = String(data.get('reference')); const bt = validDate(birth); const rt = validDate(reference); if (bt === null || rt === null || bt > rt) { result.textContent = '생년월일과 기준일을 올바르게 입력해 주세요.'; return; } const [by, bm, bd] = birth.split('-').map(Number); const [ry, rm, rd] = reference.split('-').map(Number); const age = ry - by - (rm < bm || (rm === bm && rd < bd) ? 1 : 0); result.textContent = `만 ${age}세`; });
</script>
