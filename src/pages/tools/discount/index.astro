---
import ToolPage from '../../../components/ToolPage.astro';
---
<ToolPage eyebrow="계산 · Discount" title="할인율 계산기" description="원래 가격과 할인율을 입력하면 할인 금액과 최종 가격을 계산합니다.">
  <section class="tool-card tool-card-single" aria-labelledby="discount-title"><h2 id="discount-title">할인 가격 계산</h2><form data-discount-form><label>원래 가격<input name="price" type="number" min="0" step="any" inputmode="decimal" placeholder="50000" required /></label><label>할인율<input name="rate" type="number" min="0" step="any" inputmode="decimal" placeholder="20" required /></label><button type="submit">계산하기</button></form><output class="result result-stack" data-discount-result aria-live="polite">가격과 할인율을 입력해 보세요.</output></section>
  <section class="tool-info"><h2>사용 방법</h2><ol><li>원래 가격을 입력합니다.</li><li>0~100% 사이의 할인율을 입력합니다.</li><li>계산하기를 누르면 할인 금액과 최종 가격을 확인합니다.</li></ol><h2>계산 기준</h2><p>할인 금액은 원래 가격 × 할인율 ÷ 100이며, 최종 가격은 원래 가격에서 할인 금액을 뺀 값입니다.</p><h2>예시</h2><p>50,000원에서 20%를 할인하면 할인 금액은 10,000원, 최종 가격은 40,000원입니다.</p><h2>자주 묻는 질문</h2><p><strong>할인율 100%도 가능한가요?</strong><br />네. 최종 가격은 0으로 계산됩니다.</p><p><strong>소수 가격도 가능한가요?</strong><br />네. 소수 입력을 지원합니다.</p></section>
  <nav class="related-tools" aria-label="관련 도구"><h2>관련 도구</h2><a href="/tools/percentage/">퍼센트 계산기</a><a href="/tools/ratio/">비율 계산기</a></nav>
</ToolPage>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-discount-form]'); const result = document.querySelector<HTMLOutputElement>('[data-discount-result]'); const format = (value: number) => Number(value.toFixed(8)).toLocaleString('ko-KR');
  if (!form || !result) throw new Error('할인율 계산기 요소를 찾을 수 없습니다.');
  form?.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); const price = Number(data.get('price')); const rate = Number(data.get('rate')); if (!Number.isFinite(price) || !Number.isFinite(rate)) { result.textContent = '유효한 숫자를 입력해 주세요.'; return; } if (price < 0 || rate < 0 || rate > 100) { result.textContent = '가격은 0 이상, 할인율은 0~100%로 입력해 주세요.'; return; } const amount = price * rate / 100; result.innerHTML = `<span>할인 금액 <strong>${format(amount)}</strong></span><span>최종 가격 <strong>${format(price - amount)}</strong></span>`; });
</script>
