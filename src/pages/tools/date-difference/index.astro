---
import ToolPage from '../../../components/ToolPage.astro';
---
<ToolPage eyebrow="날짜 · Date" title="날짜 차이 계산기" description="두 날짜 사이의 경과 일수를 빠르게 계산합니다.">
  <section class="tool-card tool-card-single"><h2>두 날짜 사이</h2><form data-date-form><label>시작 날짜<input name="start" type="date" required /></label><label>종료 날짜<input name="end" type="date" required /></label><button type="submit">계산하기</button></form><output class="result" data-date-result aria-live="polite">두 날짜를 입력해 보세요.</output></section>
  <section class="tool-info"><h2>사용 방법</h2><ol><li>시작 날짜와 종료 날짜를 선택합니다.</li><li>계산하기를 눌러 경과 일수를 확인합니다.</li></ol><h2>계산 기준</h2><p>시작일과 종료일을 모두 포함하지 않는 두 날짜 간 경과 일수입니다. 결과는 절대값으로 표시합니다.</p><h2>예시</h2><p>2026-09-01에서 2026-09-14는 13일이며, 같은 날짜는 0일입니다.</p><h2>자주 묻는 질문</h2><p><strong>윤년도 계산되나요?</strong><br />네. 달력 기준으로 계산합니다.</p><p><strong>날짜 순서가 반대면?</strong><br />두 날짜 사이의 절대 차이를 표시합니다.</p></section>
  <nav class="related-tools" aria-label="관련 도구"><h2>관련 도구</h2><a href="/tools/age/">나이 계산기</a><a href="/tools/time-calculator/">시간 계산기</a></nav>
</ToolPage>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-date-form]'); const result = document.querySelector<HTMLOutputElement>('[data-date-result]');
  if (!form || !result) throw new Error('날짜 계산기 요소를 찾을 수 없습니다.');
  form.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); const start = String(data.get('start')); const end = String(data.get('end')); const parse = (v: string) => { const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v); if (!m) return null; const d = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3]))); return d.getUTCFullYear() === Number(m[1]) && d.getUTCMonth() === Number(m[2]) - 1 && d.getUTCDate() === Number(m[3]) ? d.getTime() : null; }; const a = parse(start); const b = parse(end); if (a === null || b === null) { result.textContent = '유효한 날짜를 입력해 주세요.'; return; } const days = Math.abs(b - a) / 86400000; result.textContent = `${days.toLocaleString('ko-KR')}일 (${Math.floor(days / 7)}주 ${days % 7}일)`; });
</script>
