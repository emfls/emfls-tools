---
import ToolPage from '../../../components/ToolPage.astro';
---
<ToolPage eyebrow="시간 · Time" title="시간 계산기" description="기준 시간에 시간을 더하거나 빼서 결과 시간을 계산합니다.">
  <section class="tool-card tool-card-single"><h2>시간 더하기 / 빼기</h2><form data-time-form><label>기준 시간<input name="time" type="time" required /></label><div class="time-adjust"><label>방향<select name="operation"><option value="add">더하기</option><option value="subtract">빼기</option></select></label><label>시간<input name="hours" type="number" min="0" step="1" inputmode="numeric" value="0" required /></label><label>분<input name="minutes" type="number" min="0" step="1" inputmode="numeric" value="0" required /></label></div><button type="submit">계산하기</button></form><output class="result result-stack" data-time-result aria-live="polite">시간을 입력해 보세요.</output></section>
  <section class="tool-info"><h2>사용 방법</h2><ol><li>기준 시간을 선택합니다.</li><li>더하기 또는 빼기와 시간·분을 입력합니다.</li><li>계산 결과와 기준 시간에서 이동한 날짜 수를 확인합니다.</li></ol><h2>계산 기준</h2><p>시간을 분 단위로 계산한 뒤 24시간 형식과 전체 날짜 이동 일수로 표시합니다. 날짜 입력은 받지 않으므로 실제 달력 날짜나 시간대는 계산하지 않습니다.</p><h2>예시</h2><p>10:30 + 2시간 45분은 13:15, 10:30 - 1시간은 09:30입니다. 23:30 + 2시간은 01:30 (1일 후), 10:00 + 49시간은 11:00 (2일 후)입니다.</p><h2>자주 묻는 질문</h2><p><strong>시간을 뺄 수도 있나요?</strong><br />방향을 ‘빼기’로 선택하면 됩니다.</p><p><strong>날짜까지 계산하나요?</strong><br />기준 시각에서 지난 날짜 수는 표시하지만 달력 날짜와 시간대는 입력하지 않아 계산하지 않습니다.</p></section>
  <nav class="related-tools" aria-label="관련 도구"><h2>관련 도구</h2><a href="/tools/date-difference/">날짜 차이 계산기</a><a href="/tools/age/">나이 계산기</a></nav>
</ToolPage>
<script>
  import { calculateTime } from '../../../lib/tool-logic.mjs';
  const form = document.querySelector<HTMLFormElement>('[data-time-form]'); const result = document.querySelector<HTMLOutputElement>('[data-time-result]');
  if (!form || !result) throw new Error('시간 계산기 요소를 찾을 수 없습니다.');
  form.addEventListener('submit', (event) => { event.preventDefault(); const data = new FormData(form); const operation = String(data.get('operation')); if (operation !== 'add' && operation !== 'subtract') { result.textContent = '시간과 분을 올바르게 입력해 주세요.'; return; } const calculation = calculateTime(String(data.get('time')), Number(data.get('hours')), Number(data.get('minutes')), operation); if (!calculation) { result.textContent = '시간과 분을 올바르게 입력해 주세요.'; return; } const dayLabel = calculation.dayOffset > 0 ? `${calculation.dayOffset}일 후` : calculation.dayOffset < 0 ? `${Math.abs(calculation.dayOffset)}일 전` : '당일'; result.textContent = `${calculation.time} (${dayLabel})`; });
</script>
