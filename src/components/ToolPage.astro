---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props { title: string; description: string; eyebrow: string; }
const { title, description, eyebrow } = Astro.props;
const currentUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const breadcrumbData = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '홈', item: 'https://tools.emfls.com/' }, { '@type': 'ListItem', position: 2, name: '도구', item: 'https://tools.emfls.com/tools/' }, { '@type': 'ListItem', position: 3, name: title, item: currentUrl }] };
---

<BaseLayout title={`${title} — emfls tools`} description={description}>
  <article class="tool-page">
    <nav class="breadcrumbs" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">›</span><a href="/tools/">도구</a><span aria-hidden="true">›</span><span aria-current="page">{title}</span></nav>
    <header class="tool-heading"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="intro">{description}</p></header>
    <div class="tool-content"><slot /></div>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbData)} />
</BaseLayout>
